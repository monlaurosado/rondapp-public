{
  "name": "rondapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "expo": "~57.0.28",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.15",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "node scripts/dependency-security.mjs verify && expo export --platform web --output-dir dist && node scripts/prepare-hostinger-build.mjs dist && node scripts/qa-pwa.mjs dist",
    "build:web": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "qa:release:local": "node scripts/qa-release-local.mjs",
    "qa:release:static": "node scripts/qa-release-static.mjs",
    "qa:pwa": "node scripts/qa-pwa.mjs dist",
    "qa:navigation": "node --no-warnings --experimental-strip-types scripts/qa-navigation.mjs",
    "qa:errors": "node --no-warnings --experimental-strip-types scripts/qa-errors.mjs",
    "qa:supabase:local": "node scripts/qa-supabase-local.mjs",
    "qa:web-push:local": "node scripts/qa-web-push-local.mjs",
    "qa:supabase:remote:managed": "node scripts/qa-supabase-remote-managed.mjs",
    "qa:supabase:remote:smoke": "node scripts/qa-supabase-remote-smoke.mjs",
    "qa:auth:google": "node scripts/qa-google-oauth.mjs",
    "qa:visual:seed": "node scripts/qa-visual-seed.mjs --local",
    "qa:visual:cleanup": "node scripts/qa-visual-seed.mjs --local --cleanup",
    "supabase:auth:configure": "node scripts/apply-supabase-auth-settings.mjs",
    "supabase:auth:google": "node scripts/apply-supabase-google-oauth.mjs",
    "update:preview": "npx eas-cli update --channel preview --environment preview",
    "update:production": "npx eas-cli update --channel production --environment production",
    "build:android:preview": "node scripts/build-android-preview.mjs",
    "build:ios:preview": "npx eas-cli build -p ios --profile preview",
    "build:all:preview": "npx eas-cli build --profile preview --platform all",
    "postinstall": "node scripts/dependency-security.mjs apply",
    "audit:security": "node scripts/dependency-security.mjs audit",
    "test:security:dependencies": "node scripts/dependency-security.mjs verify && node --test scripts/dependency-security.test.mjs",
    "test:security:push": "npx --yes deno test --config supabase/functions/send-test-notification/deno.json --allow-env --allow-read --allow-sys supabase/functions/_shared/*test.ts"
  },
  "private": true,
  "overrides": {
    "expo-router": "$expo-router",
    "decode-uri-component": "^0.5.0",
    "uuid": "11.1.1",
    "image-size": "^2.0.4",
    "react-native-screens": "$react-native-screens"
  }
}
